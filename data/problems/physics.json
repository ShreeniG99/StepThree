[
{"id":"phy01","topic":"physics","kind":"expr","statement":"A car moving at 36 km/h accelerates uniformly at 2 m/s^2 for 5 s. Find its final speed.","steps":["36*kilometer/hour + (2*meter/second**2)*(5*second)","36*kilometer/hour + 10*meter/second","36*1000*meter/(3600*second) + 10*meter/second","10*meter/second + 10*meter/second","20*meter/second"],"final_answer":"20*meter/second"},
{"id":"phy02","topic":"physics","kind":"expr","statement":"A train moves at 72 km/h for 15 minutes. How far does it travel, in metres?","steps":["(72*kilometer/hour)*(15*minute)","72*15*kilometer*minute/hour","1080*kilometer*minute/hour","18*kilometer","18000*meter"],"final_answer":"18000*meter"},
{"id":"phy03","topic":"physics","kind":"expr","statement":"A 500 g block accelerates at 4 m/s^2 against a 1 N friction force. Find the applied force.","steps":["500*gram*4*meter/second**2 + newton","2000*gram*meter/second**2 + newton","2*kilogram*meter/second**2 + newton","2*newton + newton","3*newton"],"final_answer":"3*newton"},
{"id":"phy04","topic":"physics","kind":"expr","statement":"Find the kinetic energy of a 2000 g ball moving at 18 km/h.","steps":["(1/2)*(2000*gram)*(18*kilometer/hour)**2","(1/2)*(2*kilogram)*(18*kilometer/hour)**2","kilogram*(18*kilometer/hour)**2","kilogram*(5*meter/second)**2","25*joule"],"final_answer":"25*joule"},
{"id":"phy05","topic":"physics","kind":"expr","statement":"Find the work done lifting a 5 kg mass through 80 cm (g = 10 m/s^2).","steps":["5*kilogram*(10*meter/second**2)*(80*centimeter)","50*newton*80*centimeter","4000*newton*centimeter","40*newton*meter","40*joule"],"final_answer":"40*joule"},
{"id":"phy06","topic":"physics","kind":"expr","statement":"A cyclist covers 30 km in 40 min and then 20 km in 20 min. Find the average speed in m/s.","steps":["(30*kilometer + 20*kilometer)/(40*minute + 20*minute)","(50*kilometer)/(60*minute)","50*kilometer/hour","50*1000*meter/(3600*second)","125*meter/(9*second)"],"final_answer":"125*meter/(9*second)"},
{"id":"phy07","topic":"physics","kind":"expr","statement":"A motor does 3000 J of work in 2 minutes. Find its power.","steps":["3000*joule/(2*minute)","1500*joule/minute","1500*joule/(60*second)","25*watt"],"final_answer":"25*watt"},
{"id":"phy08","topic":"physics","kind":"expr","statement":"A force of 200 N acts on an area of 50 cm^2. Find the pressure in pascals.","steps":["200*newton/(50*centimeter**2)","4*newton/centimeter**2","4*newton/((meter/100)**2)","40000*newton/meter**2","40000*pascal"],"final_answer":"40000*pascal"},
{"id":"phy09","topic":"physics","kind":"expr","statement":"A car at 54 km/h brakes with deceleration 3 m/s^2. Find its stopping distance v^2/(2a).","steps":["(54*kilometer/hour)**2/(2*3*meter/second**2)","(54*kilometer/hour)**2/(6*meter/second**2)","(15*meter/second)**2/(6*meter/second**2)","(225*meter**2/second**2)/(6*meter/second**2)","75*meter/2"],"final_answer":"75*meter/2"},
{"id":"phy10","topic":"physics","kind":"expr","statement":"A 200 g ball hits a wall at 36 km/h and rebounds at 18 km/h. Find the magnitude of the impulse.","steps":["200*gram*(36*kilometer/hour + 18*kilometer/hour)","200*gram*54*kilometer/hour","kilogram*54*kilometer/(5*hour)","kilogram*15*meter/(5*second)","3*kilogram*meter/second"],"final_answer":"3*kilogram*meter/second"},
{"id":"phy11","topic":"physics","kind":"expr","statement":"Find the heat needed to warm 500 g of water by 20 K (c = 4200 J/(kg K)).","steps":["500*gram*(4200*joule/(kilogram*kelvin))*(20*kelvin)","500*gram*84000*joule/kilogram","kilogram/2*84000*joule/kilogram","42000*joule"],"final_answer":"42000*joule"},
{"id":"phy12","topic":"physics","kind":"expr","statement":"A current of 0.5 A flows through a 20 ohm resistor for 2 minutes. Find the heat produced (I^2 R t).","steps":["(ampere/2)**2*(20*ohm)*(2*minute)","(ampere**2/4)*20*ohm*2*minute","10*ampere**2*ohm*minute","10*ampere**2*ohm*60*second","600*joule"],"final_answer":"600*joule"},
{"id":"phy13","topic":"physics","kind":"expr","statement":"A spring with k = 200 N/m is stretched by 5 cm. Find the stored energy.","steps":["(1/2)*(200*newton/meter)*(5*centimeter)**2","100*newton/meter*25*centimeter**2","2500*newton*centimeter**2/meter","2500*newton*meter/10000","joule/4"],"final_answer":"joule/4"},
