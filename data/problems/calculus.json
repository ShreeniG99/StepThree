[
{"id":"cal01","topic":"calculus","kind":"expr","statement":"Differentiate y = sin(x^2) cos(3x).","steps":["Derivative(sin(x**2)*cos(3*x), x)","Derivative(sin(x**2), x)*cos(3*x) + sin(x**2)*Derivative(cos(3*x), x)","2*x*cos(x**2)*cos(3*x) + sin(x**2)*Derivative(cos(3*x), x)","2*x*cos(x**2)*cos(3*x) - 3*sin(x**2)*sin(3*x)"],"final_answer":"2*x*cos(x**2)*cos(3*x) - 3*sin(x**2)*sin(3*x)"},
{"id":"cal02","topic":"calculus","kind":"expr","statement":"Differentiate y = (3x + 1)^4 e^(2x).","steps":["Derivative((3*x + 1)**4*exp(2*x), x)","Derivative((3*x + 1)**4, x)*exp(2*x) + (3*x + 1)**4*Derivative(exp(2*x), x)","12*(3*x + 1)**3*exp(2*x) + (3*x + 1)**4*Derivative(exp(2*x), x)","12*(3*x + 1)**3*exp(2*x) + 2*(3*x + 1)**4*exp(2*x)","(3*x + 1)**3*(6*x + 14)*exp(2*x)"],"final_answer":"(3*x + 1)**3*(6*x + 14)*exp(2*x)"},
{"id":"cal03","topic":"calculus","kind":"expr","statement":"Differentiate y = ln(x^2 + 1) + sqrt(4x + 1).","steps":["Derivative(log(x**2 + 1) + sqrt(4*x + 1), x)","Derivative(log(x**2 + 1), x) + Derivative(sqrt(4*x + 1), x)","2*x/(x**2 + 1) + Derivative(sqrt(4*x + 1), x)","2*x/(x**2 + 1) + 2/sqrt(4*x + 1)"],"final_answer":"2*x/(x**2 + 1) + 2/sqrt(4*x + 1)"},
{"id":"cal04","topic":"calculus","kind":"expr","statement":"Differentiate y = sin^3(x) + cos(2x).","steps":["Derivative(sin(x)**3 + cos(2*x), x)","Derivative(sin(x)**3, x) + Derivative(cos(2*x), x)","3*sin(x)**2*cos(x) + Derivative(cos(2*x), x)","3*sin(x)**2*cos(x) - 2*sin(2*x)"],"final_answer":"3*sin(x)**2*cos(x) - 2*sin(2*x)"},
{"id":"cal05","topic":"calculus","kind":"expr","statement":"Differentiate y = x e^(x^2).","steps":["Derivative(x*exp(x**2), x)","exp(x**2) + x*Derivative(exp(x**2), x)","exp(x**2) + x*2*x*exp(x**2)","(1 + 2*x**2)*exp(x**2)"],"final_answer":"(1 + 2*x**2)*exp(x**2)"},
{"id":"cal06","topic":"calculus","kind":"expr","statement":"Differentiate y = tan(3x) + (x^2 - 1)^5.","steps":["Derivative(tan(3*x) + (x**2 - 1)**5, x)","Derivative(tan(3*x), x) + Derivative((x**2 - 1)**5, x)","3/cos(3*x)**2 + Derivative((x**2 - 1)**5, x)","3/cos(3*x)**2 + 10*x*(x**2 - 1)**4"],"final_answer":"3/cos(3*x)**2 + 10*x*(x**2 - 1)**4"},
{"id":"cal07","topic":"calculus","kind":"expr","statement":"Differentiate y = cos(x^3) e^(-x).","steps":["Derivative(cos(x**3)*exp(-x), x)","Derivative(cos(x**3), x)*exp(-x) + cos(x**3)*Derivative(exp(-x), x)","-3*x**2*sin(x**3)*exp(-x) + cos(x**3)*Derivative(exp(-x), x)","-3*x**2*sin(x**3)*exp(-x) - cos(x**3)*exp(-x)","-(3*x**2*sin(x**3) + cos(x**3))*exp(-x)"],"final_answer":"-(3*x**2*sin(x**3) + cos(x**3))*exp(-x)"},
{"id":"cal08","topic":"calculus","kind":"expr","statement":"Differentiate y = ln(sin x) + e^(3x).","steps":["Derivative(log(sin(x)) + exp(3*x), x)","Derivative(log(sin(x)), x) + Derivative(exp(3*x), x)","cos(x)/sin(x) + Derivative(exp(3*x), x)","cos(x)/sin(x) + 3*exp(3*x)","cot(x) + 3*exp(3*x)"],"final_answer":"cot(x) + 3*exp(3*x)"},
{"id":"cal09","topic":"calculus","kind":"expr","statement":"Differentiate y = (2x + 1) sqrt(x^2 + 9).","steps":["Derivative((2*x + 1)*sqrt(x**2 + 9), x)","2*sqrt(x**2 + 9) + (2*x + 1)*Derivative(sqrt(x**2 + 9), x)","2*sqrt(x**2 + 9) + (2*x + 1)*x/sqrt(x**2 + 9)","(2*(x**2 + 9) + x*(2*x + 1))/sqrt(x**2 + 9)","(4*x**2 + x + 18)/sqrt(x**2 + 9)"],"final_answer":"(4*x**2 + x + 18)/sqrt(x**2 + 9)"},
{"id":"cal10","topic":"calculus","kind":"expr","statement":"Differentiate y = e^(sin x) + (5x - 2)^3.","steps":["Derivative(exp(sin(x)) + (5*x - 2)**3, x)","exp(sin(x))*Derivative(sin(x), x) + Derivative((5*x - 2)**3, x)","exp(sin(x))*cos(x) + Derivative((5*x - 2)**3, x)","exp(sin(x))*cos(x) + 15*(5*x - 2)**2"],"final_answer":"exp(sin(x))*cos(x) + 15*(5*x - 2)**2"},
{"id":"cal11","topic":"calculus","kind":"expr","statement":"Differentiate y = (2x - 3)^5 - 1/(x^2 + 1).","steps":["Derivative((2*x - 3)**5 - 1/(x**2 + 1), x)","Derivative((2*x - 3)**5, x) - Derivative(1/(x**2 + 1), x)","10*(2*x - 3)**4 - Derivative(1/(x**2 + 1), x)","10*(2*x - 3)**4 + 2*x/(x**2 + 1)**2"],"final_answer":"10*(2*x - 3)**4 + 2*x/(x**2 + 1)**2"},
{"id":"cal12","topic":"calculus","kind":"expr","statement":"Differentiate y = sin(sqrt(x)) + cos(x^2).","steps":["Derivative(sin(sqrt(x)) + cos(x**2), x)","cos(sqrt(x))*Derivative(sqrt(x), x) + Derivative(cos(x**2), x)","cos(sqrt(x))/(2*sqrt(x)) + Derivative(cos(x**2), x)","cos(sqrt(x))/(2*sqrt(x)) - 2*x*sin(x**2)"],"final_answer":"cos(sqrt(x))/(2*sqrt(x)) - 2*x*sin(x**2)"},
{"id":"cal13","topic":"calculus","kind":"expr","statement":"Differentiate y = x^2 ln(3x + 2).","steps":["Derivative(x**2*log(3*x + 2), x)","2*x*log(3*x + 2) + x**2*Derivative(log(3*x + 2), x)","2*x*log(3*x + 2) + 3*x**2/(3*x + 2)"],"final_answer":"2*x*log(3*x + 2) + 3*x**2/(3*x + 2)"},
{"id":"cal14","topic":"calculus","kind":"expr","statement":"Differentiate y = cos^2(5x) + e^(x^3).","steps":["Derivative(cos(5*x)**2 + exp(x**3), x)","2*cos(5*x)*Derivative(cos(5*x), x) + Derivative(exp(x**3), x)","2*cos(5*x)*(-5*sin(5*x)) + Derivative(exp(x**3), x)","-10*sin(5*x)*cos(5*x) + 3*x**2*exp(x**3)","-5*sin(10*x) + 3*x**2*exp(x**3)"],"final_answer":"-5*sin(10*x) + 3*x**2*exp(x**3)"},
{"id":"cal15","topic":"calculus","kind":"expr","statement":"Evaluate the integral of 2x e^(x^2) from 0 to 1 (substitute u = x^2).","steps":["Integral(2*x*exp(x**2), (x, 0, 1))","Integral(exp(u), (u, 0, 1))","exp(1) - exp(0)","E - 1"],"final_answer":"E - 1"},
{"id":"cal16","topic":"calculus","kind":"expr","statement":"Evaluate the integral of (3x^2 + 4x - 1) from 0 to 2.","steps":["Integral(3*x**2 + 4*x - 1, (x, 0, 2))","(2**3 + 2*2**2 - 2) - (0**3 + 2*0**2 - 0)","8 + 8 - 2","14"],"final_answer":"14"},
{"id":"cal17","topic":"calculus","kind":"expr","statement":"Evaluate the integral of sin(x) cos(x) from 0 to pi/2.","steps":["Integral(sin(x)*cos(x), (x, 0, pi/2))","Integral(sin(2*x)/2, (x, 0, pi/2))","(-cos(pi)/4) - (-cos(0)/4)","1/4 + 1/4","1/2"],"final_answer":"1/2"}
